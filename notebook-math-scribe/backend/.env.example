# Required: your OpenAI API key
OPENAI_API_KEY=

# Optional: defaults to gpt-4o-mini if unset
OPENAI_MODEL=gpt-4o-mini

# Optional but recommended: shared secret the extension must send back as
# the X-API-Key header on every /convert request. If left blank, the
# /convert endpoint skips the check (fine for local dev, not for a publicly
# reachable deploy).
API_SHARED_SECRET=
